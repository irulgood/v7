#!/bin/bash
NC='\e[0m'
GREEN='\033[0;36m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
CONFIG="/etc/xray/config.json"
MODE_FILE="/etc/ari-ui-mode"
[ -f "$MODE_FILE" ] && UI_MODE="$(cat "$MODE_FILE")" || UI_MODE="full"

summary() {
  clear
  echo -e "\033[0;34m┌──────────────────────────────────────────────┐${NC}"
  echo -e "\033[0;34m│ \033[41;97m               ROUTING MANAGER              \033[0;34m \033[0;34m│${NC}" 
  echo -e "\033[0;34m└──────────────────────────────────────────────┘${NC}"
  echo -e "\033[0;34m┌──────────────────────────────────────────────┐${NC}"
  if [ ! -f "$CONFIG" ]; then
    echo -e "\033[0;34m│  ${RED}Config tidak ditemukan: $CONFIG${NC}"
    echo -e "\033[0;34m└──────────────────────────────────────────────┘${NC}"
    return
  fi
  if command -v jq >/dev/null 2>&1; then
    out_tags="$(jq -r '.outbounds[]?.tag // empty' "$CONFIG" 2>/dev/null | paste -sd ', ' -)"
    [ -z "$out_tags" ] && out_tags="none"
    rules_count="$(jq '.routing.rules | length // 0' "$CONFIG" 2>/dev/null)"
    echo -e "\033[0;34m│  ${GREEN}OUTBOUNDS${NC} : $out_tags"
    echo -e "\033[0;34m│  ${GREEN}RULES${NC}    : $rules_count"
  else
    echo -e "\033[0;34m│  ${YELLOW}jq tidak tersedia (raw mode).${NC}"
  fi
  echo -e "\033[0;34m└──────────────────────────────────────────────┘${NC}"
}

check_config() {
  echo
  echo -e "${YELLOW}Check config xray...${NC}"
  if command -v xray >/dev/null 2>&1; then
    xray run -test -config "$CONFIG"
  else
    echo -e "${RED}Binary xray tidak ditemukan.${NC}"
  fi
}

backup_config() {
  local ts
  ts="$(date +%Y%m%d-%H%M%S)"
  cp -f "$CONFIG" "${CONFIG}.bak-${ts}" && echo -e "${GREEN}Backup: ${CONFIG}.bak-${ts}${NC}"
}

while true; do
  summary
  echo -e "\033[0;34m┌──────────────────────────────────────────────┐${NC}"
  echo -e "\033[0;34m│  ${GREEN}1.)${NC} Check Config Routing                    \033[0;34m│${NC}"
  echo -e "\033[0;34m│  ${GREEN}2.)${NC} Backup Config                           \033[0;34m│${NC}"
  echo -e "\033[0;34m│  ${GREEN}3.)${NC} Edit Routing (nano)                     \033[0;34m│${NC}"
  echo -e "\033[0;34m│  ${GREEN}x.)${NC} Kembali                                 \033[0;34m│${NC}"
  echo -e "\033[0;34m└──────────────────────────────────────────────┘${NC}"
  #echo -e "Press [x] Back | UI: ${YELLOW}${UI_MODE}${NC} | Last update: $(date +%F)"
  read -rp " Select From Options [1-3,x] : " opt
  case "$opt" in
    1) check_config; read -n 1 -s -r -p "Press any key..." ;;
    2) backup_config; read -n 1 -s -r -p "Press any key..." ;;
    3) nano "$CONFIG" ;;
    x|X) exit 0 ;;
  esac
done

