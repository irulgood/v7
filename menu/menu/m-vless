create_custom_uuid_vless() {
    read -rp "Input custom UUID : " custom_uuid
    if [ -z "$custom_uuid" ]; then
        echo -e "${RED}UUID tidak boleh kosong.${NC}"
        sleep 1
        m-vless
        return
    fi
    CUSTOM_UUID="$custom_uuid" addvless
}

modify_uuid_vless() {
    local user exp old_uuid quota iplimit new_uuid
    read -rp "Input Username : " user
    [ -z "$user" ] && m-vless && return
    read -rp "Input UUID baru : " new_uuid
    [ -z "$new_uuid" ] && m-vless && return
    exp=$(awk -v u="$user" '$1=="###" && $2==u {print $3}' /etc/vless/.vless.db)
    old_uuid=$(awk -v u="$user" '$1=="###" && $2==u {print $4}' /etc/vless/.vless.db)
    quota=$(awk -v u="$user" '$1=="###" && $2==u {print $5}' /etc/vless/.vless.db)
    iplimit=$(awk -v u="$user" '$1=="###" && $2==u {print $6}' /etc/vless/.vless.db)
    if [ -z "$exp" ] || [ -z "$old_uuid" ]; then
        echo -e "${RED}User tidak ditemukan di database VLESS.${NC}"
        sleep 1
        m-vless
        return
    fi
    sed -i "/^#& $user $exp/,/^},{/d" /etc/xray/config.json
    sed -i '/#vless$/a\#& '"$user $exp"'\
},{"id": "'""$new_uuid""'","email": "'""$user""'"' /etc/xray/config.json
    sed -i '/#vlessgrpc$/a\#& '"$user $exp"'\
},{"id": "'""$new_uuid""'","email": "'""$user""'"' /etc/xray/config.json
    sed -i -E "s|^### $user $exp .*|### $user $exp $new_uuid ${quota:-0} ${iplimit:-0}|" /etc/vless/.vless.db
    systemctl restart xray >/dev/null 2>&1
    echo -e "${GREEN}UUID VLESS untuk ${user} berhasil diubah.${NC}"
    sleep 1
    m-vless
}

lock_vless() {
    local user exp
    read -rp "Input Username : " user
    [ -z "$user" ] && m-vless && return
    exp=$(awk -v u="$user" '$1=="###" && $2==u {print $3}' /etc/vless/.vless.db)
    if [ -z "$exp" ]; then
        echo -e "${RED}User tidak ditemukan.${NC}"
        sleep 1
        m-vless
        return
    fi
    sed -i "/^#& $user $exp/,/^},{/d" /etc/xray/config.json
    systemctl restart xray >/dev/null 2>&1
    echo -e "${GREEN}User VLESS ${user} berhasil di-lock.${NC}"
    sleep 1
    m-vless
}

unlock_vless() {
    local user exp uuid
    read -rp "Input Username : " user
    [ -z "$user" ] && m-vless && return
    exp=$(awk -v u="$user" '$1=="###" && $2==u {print $3}' /etc/vless/.vless.db)
    uuid=$(awk -v u="$user" '$1=="###" && $2==u {print $4}' /etc/vless/.vless.db)
    if [ -z "$exp" ] || [ -z "$uuid" ]; then
        echo -e "${RED}User/UUID tidak ditemukan pada DB VLESS.${NC}"
        sleep 1
        m-vless
        return
    fi
    sed -i '/#vless$/a\#& '"$user $exp"'\
},{"id": "'""$uuid""'","email": "'""$user""'"' /etc/xray/config.json
    sed -i '/#vlessgrpc$/a\#& '"$user $exp"'\
},{"id": "'""$uuid""'","email": "'""$user""'"' /etc/xray/config.json
    systemctl restart xray >/dev/null 2>&1
    echo -e "${GREEN}User VLESS ${user} berhasil di-unlock.${NC}"
    sleep 1
    m-vless
}

