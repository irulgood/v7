#!/bin/bash
NC='\e[0m'
GREEN='\033[0;36m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
MODE_FILE="/etc/ari-ui-mode"
[ -f "$MODE_FILE" ] && UI_MODE="$(cat "$MODE_FILE")" || UI_MODE="full"

show_status() {
  clear
  echo -e "\033[0;34m┌──────────────────────────────────────────────┐${NC}"
  echo -e "\033[0;34m│ \033[41;97m            WARP CLOUDFLARE MANAGER         \033[0;34m │${NC}" 
  echo -e "\033[0;34m└──────────────────────────────────────────────┘${NC}"
  echo -e "\033[0;34m┌──────────────────────────────────────────────┐${NC}"
  if command -v warp-cli >/dev/null 2>&1; then
    echo -e "\033[0;34m│  ${GREEN}ENGINE${NC} : warp-cli"
    warp_stat="$(warp-cli --accept-tos status 2>/dev/null | sed -n '1p')"
    [ -z "$warp_stat" ] && warp_stat="status unavailable"
    echo -e "\033[0;34m│  ${GREEN}STATUS${NC} : $warp_stat"
  elif command -v wgcf >/dev/null 2>&1; then
    echo -e "\033[0;34m│  ${GREEN}ENGINE${NC} : wgcf"
    wgcf_stat="$(wgcf status 2>/dev/null | sed -n '1p')"
    [ -z "$wgcf_stat" ] && wgcf_stat="status unavailable"
    echo -e "\033[0;34m│  ${GREEN}STATUS${NC} : $wgcf_stat"
  else
    echo -e "\033[0;34m│  ${RED}WARP belum terpasang.${NC}"
  fi
  echo -e "\033[0;34m└──────────────────────────────────────────────┘${NC}"
}

while true; do
  show_status
  echo -e "\033[0;34m┌──────────────────────────────────────────────┐${NC}"
  echo -e "\033[0;34m│  ${GREEN}1.)${NC} Connect WARP                            \033[0;34m│${NC}"
  echo -e "\033[0;34m│  ${GREEN}2.)${NC} Disconnect WARP                         \033[0;34m│${NC}"
  echo -e "\033[0;34m│  ${GREEN}3.)${NC} Show Detail Status                      \033[0;34m│${NC}"
  echo -e "\033[0;34m│  ${GREEN}x.)${NC} Kembali                                 \033[0;34m│${NC}"
  echo -e "\033[0;34m└──────────────────────────────────────────────┘${NC}"
  #echo -e "Press [x] Back | UI: ${YELLOW}${UI_MODE}${NC} | Last update: $(date +%F)"
  read -rp " Select From Options [1-3,x] : " opt
  case "$opt" in
    1)
      if command -v warp-cli >/dev/null 2>&1; then
        warp-cli --accept-tos register >/dev/null 2>&1 || true
        warp-cli --accept-tos connect || true
      else
        echo -e "${RED}warp-cli tidak ditemukan. Install WARP dulu.${NC}"
        sleep 2
      fi
      ;;
    2)
      if command -v warp-cli >/dev/null 2>&1; then
        warp-cli --accept-tos disconnect || true
      else
        echo -e "${RED}warp-cli tidak ditemukan.${NC}"
        sleep 2
      fi
      ;;
    3)
      if command -v warp-cli >/dev/null 2>&1; then
        warp-cli --accept-tos status
      else
        echo -e "${RED}warp-cli tidak ditemukan.${NC}"
      fi
      read -n 1 -s -r -p "Press any key..."
      ;;
    x|X) exit 0 ;;
  esac
done

