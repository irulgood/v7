create_custom_uuid_trojan() {
    read -rp "Input custom UUID : " custom_uuid
    if [ -z "$custom_uuid" ]; then
        echo -e "${RED}UUID tidak boleh kosong.${NC}"
        sleep 1
        m-trojan
        return
    fi
    CUSTOM_UUID="$custom_uuid" addtr
}

modify_uuid_trojan() {
    local user exp old_uuid quota iplimit new_uuid
    read -rp "Input Username : " user
    [ -z "$user" ] && m-trojan && return
    read -rp "Input UUID baru : " new_uuid
    [ -z "$new_uuid" ] && m-trojan && return
    exp=$(awk -v u="$user" '$1=="###" && $2==u {print $3}' /etc/trojan/.trojan.db)
    old_uuid=$(awk -v u="$user" '$1=="###" && $2==u {print $4}' /etc/trojan/.trojan.db)
    quota=$(awk -v u="$user" '$1=="###" && $2==u {print $5}' /etc/trojan/.trojan.db)
    iplimit=$(awk -v u="$user" '$1=="###" && $2==u {print $6}' /etc/trojan/.trojan.db)
    if [ -z "$exp" ] || [ -z "$old_uuid" ]; then
        echo -e "${RED}User tidak ditemukan di database TROJAN.${NC}"
        sleep 1
        m-trojan
        return
    fi
    sed -i "/^#! $user $exp/,/^},{/d" /etc/xray/config.json
    sed -i '/#trojanws$/a\#! '"$user $exp"'\
},{"password": "'""$new_uuid""'","email": "'""$user""'"' /etc/xray/config.json
    sed -i '/#trojangrpc$/a\#! '"$user $exp"'\
},{"password": "'""$new_uuid""'","email": "'""$user""'"' /etc/xray/config.json
    sed -i -E "s|^### $user $exp .*|### $user $exp $new_uuid ${quota:-0} ${iplimit:-0}|" /etc/trojan/.trojan.db
    systemctl restart xray >/dev/null 2>&1
    echo -e "${GREEN}UUID TROJAN untuk ${user} berhasil diubah.${NC}"
    sleep 1
    m-trojan
}

lock_trojan() {
    local user exp
    read -rp "Input Username : " user
    [ -z "$user" ] && m-trojan && return
    exp=$(awk -v u="$user" '$1=="###" && $2==u {print $3}' /etc/trojan/.trojan.db)
    if [ -z "$exp" ]; then
        echo -e "${RED}User tidak ditemukan.${NC}"
        sleep 1
        m-trojan
        return
    fi
    sed -i "/^#! $user $exp/,/^},{/d" /etc/xray/config.json
    systemctl restart xray >/dev/null 2>&1
    echo -e "${GREEN}User TROJAN ${user} berhasil di-lock.${NC}"
    sleep 1
    m-trojan
}

unlock_trojan() {
    local user exp uuid
    read -rp "Input Username : " user
    [ -z "$user" ] && m-trojan && return
    exp=$(awk -v u="$user" '$1=="###" && $2==u {print $3}' /etc/trojan/.trojan.db)
    uuid=$(awk -v u="$user" '$1=="###" && $2==u {print $4}' /etc/trojan/.trojan.db)
    if [ -z "$exp" ] || [ -z "$uuid" ]; then
        echo -e "${RED}User/UUID tidak ditemukan pada DB TROJAN.${NC}"
        sleep 1
        m-trojan
        return
    fi
    sed -i '/#trojanws$/a\#! '"$user $exp"'\
},{"password": "'""$uuid""'","email": "'""$user""'"' /etc/xray/config.json
    sed -i '/#trojangrpc$/a\#! '"$user $exp"'\
},{"password": "'""$uuid""'","email": "'""$user""'"' /etc/xray/config.json
    systemctl restart xray >/dev/null 2>&1
    echo -e "${GREEN}User TROJAN ${user} berhasil di-unlock.${NC}"
    sleep 1
    m-trojan
}

