#!/bin/bash
GREEN='\033[0;34m'
RED='\033[0;31m'
BGBLUE='\e[1;44m'
ORANGE='\033[0;33m'
BLUE='\033[1;36m'
PURPLE='\033[0;35m'
BLUE='\033[0;36m'
BG='\E[44;1;39m'
NC='\033[0;37m'
WHITE='\033[0;37m'
r="\033[1;31m"  #REDTERANG
YELLOW='\033[1;33m'
MODE_FILE="/etc/ari-ui-mode"
[ -f "$MODE_FILE" ] && UI_MODE="$(cat "$MODE_FILE")" || UI_MODE="full"
responden=$(curl -m 5 -s "http://ip-api.com/json/?fields=country,region,city,timezone,isp,query")
ISP=$(echo "$responden" | jq -r '.isp')
CITY=$(echo "$responden" | jq -r '.city')
IPVPS=$(echo "$responden" | jq -r '.query')
[ -z "$IPVPS" ] || [ "$IPVPS" = "null" ] && IPVPS=$(curl -m 5 -s ipv4.icanhazip.com)
domain=$(cat /etc/xray/domain)
if [ "$UI_MODE" = "compact" ]; then
  ISP=$(echo "$ISP" | cut -c1-24)
  domain=$(echo "$domain" | cut -c1-24)
fi
RAM=$(free -m | awk 'NR==2 {print $2}')
USAGERAM=$(free -m | awk 'NR==2 {print $3}')
MEMOFREE=$(printf '%-1s' "$(free -m | awk 'NR==2{printf "%.2f%%", $3*100/$2 }')")
LOADCPU=$(printf '%-0.00001s' "$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')")
MODEL=$(cat /etc/os-release | grep -w PRETTY_NAME | head -n1 | sed 's/=//g' | sed 's/"//g' | sed 's/PRETTY_NAME//g')
CORE=$(printf '%-1s' "$(grep -c cpu[0-9] /proc/stat)")
DATEVPS=$(date +'%d/%m/%Y')
TIMEZONE=$(printf '%(%H:%M:%S)T')
SERONLINE=$(uptime -p | cut -d " " -f 2-10000)
clear
MYIP="$IPVPS"
[ -z "$MYIP" ] || [ "$MYIP" = "null" ] && MYIP=$(curl -m 5 -sS ipv4.icanhazip.com | tr -d '\r\n')
username=$(cat /usr/bin/user 2>/dev/null || echo "OPEN-SOURCE")
valid=$(cat /usr/bin/e 2>/dev/null || echo "2099-12-31")
exp="$valid"
Info="${GREEN}Active${NC}"
Error="${RED}Expired${NC}"
sts="${Info}"
clear
uptime="$(uptime -p | cut -d " " -f 2-10)"
cpu_usage1="$(ps aux | awk 'BEGIN {sum=0} {sum+=$3}; END {print sum}')"
cpu_usage="$((${cpu_usage1/\.*} / ${coREDiilik:-1}))"
cpu_usage+=" %"
WKT=$(echo "$responden" | jq -r '.timezone')
DAY=$(date +%A)
DATE=$(date +%m/%d/%Y)
DATE2=$(date -R | cut -d " " -f -5)
IPVPS="$MYIP"
cname=$( awk -F: '/model name/ {name=$2} END {print name}' /proc/cpuinfo )
cores=$( awk -F: '/model name/ {core++} END {print core}' /proc/cpuinfo )
freq=$( awk -F: ' /cpu MHz/ {freq=$2} END {print freq}' /proc/cpuinfo )
tram=$( free -m | awk 'NR==2 {print $2}' )
uram=$( free -m | awk 'NR==2 {print $3}' )
fram=$( free -m | awk 'NR==2 {print $4}' )
clear
ssh_service=$(systemctl is-active ssh 2>/dev/null)
dropbear_service=$(systemctl is-active dropbear 2>/dev/null)
haproxy_service=$(systemctl is-active haproxy 2>/dev/null)
xray_service=$(systemctl is-active xray 2>/dev/null)
nginx_service=$(systemctl is-active nginx 2>/dev/null)
clear
if [[ $ssh_service == "active" ]]; then
status_ssh="${GREEN}✓${NC}"
else
status_ssh="${RED}🔴${NC} "
fi
ssh_ws=$(systemctl is-active ws 2>/dev/null)
if [[ $ssh_ws == "active" ]]; then
 status_ws_txt="ON"
 status_ws_epro="${GREEN}${status_ws_txt}${NC}"
else
 status_ws_txt="ER"
 status_ws_epro="${RED}${status_ws_txt}${NC}"
fi
if [[ $haproxy_service == "active" ]]; then
 status_haproxy_txt="ON"
 status_haproxy="${GREEN}${status_haproxy_txt}${NC}"
else
 status_haproxy_txt="ER"
 status_haproxy="${RED}${status_haproxy_txt}${NC}"
fi
if [[ $xray_service == "active" ]]; then
 status_xray_txt="ON"
 status_xray="${GREEN}${status_xray_txt}${NC}"
else
 status_xray_txt="ER"
 status_xray="${RED}${status_xray_txt}${NC}"
fi
if [[ $nginx_service == "active" ]]; then
status_nginx="${GREEN}ON  ${NC}"
else
status_nginx="${RED}🔴${NC} "
fi
if [[ $dropbear_service == "active" ]]; then
status_dropbear="${GREEN}ON ${NC}"
else
status_dropbear="${RED}🔴${NC} "
fi
vlx=$(grep -c -E "^#& " "/etc/xray/config.json")
let vla=$vlx/2
vmc=$(grep -c -E "^### " "/etc/xray/config.json")
let vma=$vmc/2
ssh1="$(awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd | wc -l)"
trx=$(grep -c -E "^#! " "/etc/xray/config.json")
let trb=$trx/2
ssx=$(grep -c -E "^#ss# " "/etc/xray/config.json")
let ssa=$ssx/2
r="\033[1;31m"  #REDTERANG
DROPBEAR_VERSION=$(dropbear -V 2>&1 | grep -oE 'v[0-9.]+')
XRAY_VERSION=$(xray version 2>/dev/null | head -n 1 | awk '{print $2}')
# vnStat parsing: pick usable interface (route default -> vnstat iflist -> eth0).
VN_IFACE=$(ip -o -4 route show to default 2>/dev/null | awk '{print $5; exit}')
if ! vnstat -i "$VN_IFACE" >/dev/null 2>&1; then
  VN_IFACE=$(vnstat --iflist 2>/dev/null | awk -F'[:( ]+' '/available interfaces/ {print $3; exit}')
fi
[ -z "$VN_IFACE" ] && VN_IFACE="eth0"

# vnStat v2 parser via grep+set (more robust across awk variants/locales).
vnstat_m_out=$(vnstat -m -i "$VN_IFACE" 2>/dev/null)
vnstat_d_out=$(vnstat -d -i "$VN_IFACE" 2>/dev/null)
month_row=$(printf "%s\n" "$vnstat_m_out" | grep -E -m1 '^[[:space:]]*[0-9]{4}-[0-9]{2}[[:space:]]')
if [ -n "$month_row" ]; then
  set -- $month_row
  month_line="$1"
  month_rx="$2 $3"
  month_tx="$5 $6"
  month_total="$8 $9"
fi

day_row=$(printf "%s\n" "$vnstat_d_out" | grep -E -m1 '^[[:space:]]*[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]]')
if [ -n "$day_row" ]; then
  set -- $day_row
  day_line="$1"
  day_rx="$2 $3"
  day_tx="$5 $6"
  day_total="$8 $9"
fi

# Fallback for legacy vnStat output (old scripts expected bracket format).
[ -z "$month_line" ] && month_line=$(printf "%s\n" "$vnstat_m_out" | awk '/\[/ {print $2" "$3; exit}')
[ -z "$month_rx" ] && month_rx=$(printf "%s\n" "$vnstat_m_out" | awk '/\[/ {print $4" "$5; exit}')
[ -z "$month_tx" ] && month_tx=$(printf "%s\n" "$vnstat_m_out" | awk '/\[/ {print $7" "$8; exit}')
[ -z "$month_total" ] && month_total=$(printf "%s\n" "$vnstat_m_out" | awk '/\[/ {print $10" "$11; exit}')
[ -z "$day_line" ] && day_line=$(printf "%s\n" "$vnstat_d_out" | awk '/\[/ {print $2" "$3; exit}')
[ -z "$day_rx" ] && day_rx=$(printf "%s\n" "$vnstat_d_out" | awk '/\[/ {print $4" "$5; exit}')
[ -z "$day_tx" ] && day_tx=$(printf "%s\n" "$vnstat_d_out" | awk '/\[/ {print $7" "$8; exit}')
[ -z "$day_total" ] && day_total=$(printf "%s\n" "$vnstat_d_out" | awk '/\[/ {print $10" "$11; exit}')
# Some vnStat builds reject 1-second sampling, so try 2s then fallback 5s.
vn_tr_raw=$(vnstat -tr 2 -i "$VN_IFACE" 2>/dev/null)
[ -z "$vn_tr_raw" ] && vn_tr_raw=$(vnstat -tr 5 -i "$VN_IFACE" 2>/dev/null)
# Parse live traffic rate robustly across vnStat output variants.
day_trf=$(printf "%s\n" "$vn_tr_raw" | awk '/traffic/ {for(i=1;i<=NF;i++) if($i ~ /bit\/s$/){print $(i-1)" "$i; exit}}')
[ -z "$day_trf" ] && day_trf=$(printf "%s\n" "$vn_tr_raw" | awk '{for(i=1;i<=NF;i++) if($i ~ /bit\/s$/){print $(i-1)" "$i; exit}}')
[ -z "$day_trf" ] && day_trf=$(printf "%s\n" "$vn_tr_raw" | awk '/rx/ {print $2" "$3; exit}')
[ -z "$day_trf" ] && day_trf=$(printf "%s\n" "$vn_tr_raw" | awk '/fwd/ {print $2" "$3; exit}')
[ -z "$day_trf" ] && day_trf="N/A"

# Make display closer to Potato style: show total with [Month]/[DayName]
month_name=$(date -d "${month_line}-01" +%B 2>/dev/null)
day_name=$(date -d "${day_line}" +%A 2>/dev/null)
[ -z "$month_name" ] && month_name="$month_line"
[ -z "$day_name" ] && day_name="$day_line"
month_show="$month_total [$month_name]"
day_show="$day_total [$day_name]"
[ -z "$month_line" ] && month_line="N/A"
[ -z "$month_rx" ] && month_rx="N/A"
[ -z "$month_tx" ] && month_tx="N/A"
[ -z "$month_total" ] && month_total="N/A"
[ -z "$day_line" ] && day_line="N/A"
[ -z "$day_rx" ] && day_rx="N/A"
[ -z "$day_tx" ] && day_tx="N/A"
[ -z "$day_total" ] && day_total="N/A"
[ -z "$day_trf" ] && day_trf="N/A"
[ -z "$month_show" ] && month_show="N/A"
[ -z "$day_show" ] && day_show="N/A"

# Small health tag at right side, like Potato.
if [ "$status_xray_txt" = "ON" ] && [ "$status_ws_txt" = "ON" ] && [ "$status_haproxy_txt" = "ON" ]; then
  system_health="${GREEN}GOOD   ${NC}"
else
  system_health="${YELLOW}ERROR  ${NC}"
fi

onView() {
    > mow  # clear file dulu

    for i in {52..57} {57..52}; do
        echo -en "\e[38;5;${i}m———\e[0m" >> mow
    done

    local m=$(cat mow)
    echo -e "${KEATAS}  ${m}\e[38;5;52m—\e[0m"

    rm -f mow
}

laneBlue() {
    local m=""
    local po="————"

    for i in {52..57}; do
        m+="\e[38;5;${i}m${po}\e[0m"
    done
    for i in {56..52}; do
        m+="\e[38;5;${i}m${po}\e[0m"
    done

    # tambah biar pas
    m+="\e[38;5;52m——\e[0m"
    echo -e " $m"
}

swap_total="$(free -m | awk 'NR==3 {print $2}')"
echo -e "\033[0;34m┌──────────────────────────────────────────────┐$NC"
echo -e "\033[0;34m│ \033[41;97m                ARI TUNNELING               \033[0;34m │$NC"
echo -e "\033[0;34m└──────────────────────────────────────────────┘$NC"
echo -e "\033[0;34m┌──────────────────────────────────────────────┐$NC"
echo -e "\033[0;34m│ $WHITE OS      $NC: $MODEL"
echo -e "\033[0;34m│ $WHITE RAM     $NC: ${RAM}MB"
echo -e "\033[0;34m│ $WHITE SWAP    $NC: $(free -m | awk 'NR==3 {print $2}')MB"
echo -e "\033[0;34m│ $WHITE CITY    $NC: $CITY"
echo -e "\033[0;34m│ $WHITE ISP     $NC: $ISP"
echo -e "\033[0;34m│ $WHITE IP      $NC: \033[1;31m$IPVPS\033[0m"
echo -e "\033[0;34m│ $WHITE DOMAIN  $NC: $domain"
echo -e "\033[0;34m│ $WHITE UPTIME  $NC: $SERONLINE"
echo -e "\033[0;34m│$(onView)"
echo -e "\033[0;34m│ $WHITE MONTH   $NC: $month_show"
echo -e "\033[0;34m│ $WHITE RX      $NC: $month_rx"
echo -e "\033[0;34m│ $WHITE TX      $NC: $month_tx"
echo -e "\033[0;34m│$(onView)"
echo -e "\033[0;34m│ $WHITE DAY     $NC: $day_show"
echo -e "\033[0;34m│ $WHITE RX      $NC: $day_rx"
echo -e "\033[0;34m│ $WHITE TX      $NC: $day_tx"
echo -e "\033[0;34m│ $WHITE TRAFFIC $NC: $day_trf"
echo -e "\033[0;34m└──────────────────────────────────────────────┘$NC"
echo -e "\033[0;34m┌──────────────────────────────────────────────┐$NC"
echo -e "\033[0;34m│$WHITE XRAY: $status_xray | SSH-WS: $status_ws_epro | LOADBLC: $status_haproxy | $system_health\033[0;34m│$NC"
echo -e "\033[0;34m└──────────────────────────────────────────────┘$NC"
echo -e "\033[0;34m     ┌────────────────────────────────────┐$NC"
echo -e "\033[0;34m                ${WHITE}LIST ACCOUNTS${NC}     $NC"
echo -e "\033[0;34m    $(onView)"
echo -e "\033[0;34m         ${WHITE}SSH/OPENVPN   ${NC}: ${ssh1} ACCOUNT"
echo -e "\033[0;34m         ${WHITE}VMESS         ${NC}: ${vma} ACCOUNT"
echo -e "\033[0;34m         ${WHITE}VLESS         ${NC}: ${vla} ACCOUNT"
echo -e "\033[0;34m         ${WHITE}TROJAN        ${NC}: ${trb} ACCOUNT"
echo -e "\033[0;34m     └────────────────────────────────────┘$NC"
echo -e "\033[0;34m   ┌────────────────────────────────────────┐$NC"
echo -e "\033[0;34m   │  ${WHITE}Version     ${NC}: SPv${XRAY_VERSION}"
echo -e "\033[0;34m   │  ${WHITE}Order By    ${NC}: \e[0;33mArivpnstore\e[0m"
echo -e "\033[0;34m   │  ${WHITE}Client Name ${NC}: \e[1;31m${username}\e[0m"
echo -e "\033[0;34m   │  ${WHITE}Expiry In   ${NC}: \e[1;31m${certifacate} Days\e[0m"
echo -e "\033[0;34m   └────────────────────────────────────────┘$NC"
echo -e "\e[35m$(laneBlue)$NC"
echo -e "${WHITE}          to access use ☞ menu command$NC"
echo -e "\e[35m$(laneBlue)$NC"
echo -e ""
exit 0
