modify_password_ssh() {
  read -rp "Input Username : " usr
  if ! id "$usr" >/dev/null 2>&1; then
    echo -e "${RED}User tidak ditemukan.${NC}"
    sleep 1
    m-sshws
    return
  fi
  read -rsp "Input New Password : " newpass
  echo
  if [ -z "$newpass" ]; then
    echo -e "${RED}Password tidak boleh kosong.${NC}"
    sleep 1
    m-sshws
    return
  fi
  echo -e "$newpass\n$newpass" | passwd "$usr" >/dev/null 2>&1
  echo -e "${GREEN}Password user ${usr} berhasil diubah.${NC}"
  sleep 1
  m-sshws
}

lock_ssh_user() {
  read -rp "Input Username : " usr
  if ! id "$usr" >/dev/null 2>&1; then
    echo -e "${RED}User tidak ditemukan.${NC}"
    sleep 1
    m-sshws
    return
  fi
  passwd -l "$usr" >/dev/null 2>&1
  echo -e "${GREEN}User ${usr} berhasil di-lock.${NC}"
  sleep 1
  m-sshws
}

unlock_ssh_user() {
  read -rp "Input Username : " usr
  if ! id "$usr" >/dev/null 2>&1; then
    echo -e "${RED}User tidak ditemukan.${NC}"
    sleep 1
    m-sshws
    return
  fi
  passwd -u "$usr" >/dev/null 2>&1
  echo -e "${GREEN}User ${usr} berhasil di-unlock.${NC}"
  sleep 1
  m-sshws
}

