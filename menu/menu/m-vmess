###lock vmwss
function lock() {
    clear
    echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
    echo -e "$COLOR1│${NC} ${COLBG1}             • LOCK XRAY USER •              ${NC} $COLOR1│$NC"
    echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
    read -rp "   Input Username for lock: " user

    if [ -z $user ]; then
        m-vmess
    else
        uuid=$(cat /etc/vmess/.vmess.db | grep $user | awk '{print $4}')
        if [ -z "$uuid" ]; then
            echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
            echo -e "$COLOR1│${NC}   • User not found in database."
            echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
        else
        uuid=$(cat /etc/vmess/.vmess.db | grep $user | awk '{print $4}')
        exp=$(cat /etc/vmess/.vmess.db | grep $user | awk '{print $3}')
            # Remove user from XRay configuration and database
            sed -i "/^### $user $exp/,/^},{/d" /etc/xray/config.json
                  systemctl restart xray >> /dev/null 2>&1

            clear
            echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
            echo -e "$COLOR1│${NC} ${COLBG1}             • LOCKED XRAY USER •            ${NC} $COLOR1│$NC"
            echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
            echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
            echo -e "$COLOR1│${NC}   • Account locked successfully."
            echo -e "$COLOR1│${NC}   • Client Name : $user"
            echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
        fi
        echo -e ""
        read -n 1 -s -r -p "   Press any key to back on menu"
        m-vmess
    fi
}

###unlok vmess
function unlock(){
sed -i 's/ UNLOCKED//g' /etc/vmess/.vmess.db
clear
echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
echo -e "$COLOR1│${NC} ${COLBG1}             • UNLOCK XRAY USER •              ${NC} $COLOR1│$NC"
echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
read -rp "   Input Username for unlock: " user
if [ -z $user ]; then
m-vmess
else
uuid=$(cat /etc/vmess/.vmess.db | grep $user | awk '{print $4}')
exp=$(cat /etc/vmess/.vmess.db | grep $user | awk '{print $3}')
if [ -z "$uuid" ]; then
echo "Oh tidak, UUID-mu terhapus."
echo "Membuat UUID baru..."
uuid=$(cat /proc/sys/kernel/random/uuid)
else
echo "UUID tersedia: $uuid"
fi
sed -i '/#vmess$/a\### '"$user $exp"'\
},{"id": "'""$uuid""'","alterId": '"0"',"email": "'""$user""'"' /etc/xray/config.json
sed -i '/#vmessgrpc$/a\### '"$user $exp"'\
},{"id": "'""$uuid""'","alterId": '"0"',"email": "'""$user""'"' /etc/xray/config.json
systemctl restart xray > /dev/null 2>&1
clear
echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
echo -e "$COLOR1│${NC} ${COLBG1}             • UNLOCKED XRAY USER •          ${NC} $COLOR1│$NC"
echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
echo -e "$COLOR1┌─────────────────────────────────────────────────┐${NC}"
echo -e "$COLOR1│${NC}   • Accound unlocked Successfully"
echo -e "$COLOR1\033[0;34m│${NC}"
echo -e "$COLOR1│${NC}   • Client Name : $user"
echo -e "$COLOR1│${NC}   • Expired On  : $exp"
echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
echo -e "$COLOR1┌────────────────────── BY ───────────────────────┐${NC}"
echo -e "$COLOR1│${NC}                 • ARI VPN PREMIUM •                 $COLOR1│$NC"
echo -e "$COLOR1└─────────────────────────────────────────────────┘${NC}"
echo ""
read -n 1 -s -r -p "   Press any key to back on menu"
m-vmess
fi
}
